# Copy this file to apps/api/.env and fill in real values.
# .env is git-ignored. NEVER commit real secrets.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Verifies the 60-second identity note from the web app.
# Must be IDENTICAL to API_SHARED_SECRET in apps/web/.env.local (32+ characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_SHARED_SECRET=replace-with-generated-secret

# PostgreSQL connection string. The password must match POSTGRES_PASSWORD in the root .env
# if you use docker-compose.
DATABASE_URL=postgresql://codementor:YOUR_DB_PASSWORD@localhost:5432/codementor_dev

# Password hashing cost (4-15). 12 is a good production value; lower only for tests.
BCRYPT_COST=12

# --- AI interviews (Claude) ---------------------------------------------------------------
# anthropic = real Claude (needs ANTHROPIC_API_KEY). fake = canned demo answers for trying the UI
# without a key (refused when NODE_ENV=production). Without a key the AI endpoints answer 503.
AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# Model names are configuration, not code: change them here when new models are released.
AI_MODEL_REASONING=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-4-5-20251001
# How long to wait for one AI call (milliseconds) and how many AI calls one user may make per day.
AI_TIMEOUT_MS=30000
AI_DAILY_CALL_LIMIT=200

# --- Code execution (Judge0 / Piston) --------------------------------------------------------
# judge0 = Judge0 execution. piston = Piston execution engine. fake = SIMULATED results.
CODE_EXECUTOR=judge0
# The Judge0 server's base URL. https is required except for localhost.
# JUDGE0_API_URL=https://your-judge0-host.example.com
# Pick ONE credential type (or none for an open local instance). These stay on the server: they
# are never sent to the browser and must never be given a NEXT_PUBLIC_ name.
# Self-hosted Judge0 with AUTHN_TOKEN set (sent as the X-Auth-Token header):
# JUDGE0_AUTH_TOKEN=replace-with-your-judge0-auth-token
# Judge0 on RapidAPI (sent as X-RapidAPI-Key; the host is taken from JUDGE0_API_URL):
# JUDGE0_RAPIDAPI_KEY=replace-with-your-rapidapi-key
# Optional tuning: per-request timeout, how long to wait for results, test cases per request (max 20).
JUDGE0_TIMEOUT_MS=15000
JUDGE0_POLL_TIMEOUT_MS=60000
JUDGE0_MAX_BATCH=20

# If CODE_EXECUTOR=piston:
# PISTON_API_URL=https://emkc.org/api/v2/piston (or http://localhost:2000/api/v2 for local docker)
# PISTON_API_KEY=optional-api-key
# PISTON_TIMEOUT_MS=15000

# Used once by `npm run db:seed` to create the first admin. Remove them from .env afterwards.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=choose-a-strong-password-here
