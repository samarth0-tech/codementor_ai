# Copy this file to apps/web/.env.local and fill in real values.
# .env.local is git-ignored. NEVER commit real secrets.

# Auth.js session encryption key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-generated-secret

# The public URL of this web app (used for the same-site check on state-changing requests).
AUTH_URL=http://localhost:3000

# Needed when self-hosting behind a proxy. Vercel sets this automatically; leave unset there.
# AUTH_TRUST_HOST=true

# Where the Next.js SERVER forwards API calls.
# Server-only: never prefix with NEXT_PUBLIC_ (that would expose it to the browser).
API_BASE_URL=http://localhost:4000

# Signs the 60-second identity note sent to Express.
# Must be IDENTICAL to API_SHARED_SECRET in apps/api/.env (32+ characters).
API_SHARED_SECRET=replace-with-generated-secret
