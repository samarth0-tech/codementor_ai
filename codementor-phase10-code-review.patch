+        ["MEDIUM", null],
+        ["LOW", 2],
+      ]);
+      expect(review.suggestions.map((s) => s.priority)).toEqual(["HIGH", "LOW"]);
+    });
+
+    it("repairs once, then fails cleanly with nothing stored; a retry works", async () => {
+      const sub = await makeSubmission();
