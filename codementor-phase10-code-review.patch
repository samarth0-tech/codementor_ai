+            .set("Authorization", auth);
+        expect((await send()).status).toBe(201);
+        expect((await send()).status).toBe(200);
+        const third = await send();
+        expect(third.status).toBe(429);
+        expect(third.body.error.code).toBe("RATE_LIMITED");
